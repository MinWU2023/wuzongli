{
  "expo": {
    "name": "好线索",
    "slug": "haoxiansuo",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F4FF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "me.yzz.haoxiansuo",
      "buildNumber": "8",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt"
        ]
      }
    },
    "android": {
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8F4FF"
      },
      "package": "me.yzz.haoxiansuo",
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBase": "https://google.yzz.me",
      "eas": {
        "projectId": "03a39ee7-493d-4cf5-863f-83e835d6fca6"
      }
    }
  }
}
